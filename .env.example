# Postgres connection string
# Local (docker compose up -d): postgres://doless:doless@localhost:5432/doless
DATABASE_URL=postgres://doless:doless@localhost:5432/doless

# Public site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (SMTP). Every brief is emailed to CONTACT_TO_EMAIL, with reply-to set to the sender.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords), and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=thavishamudunkotuwa1998@gmail.com
# Optional. Defaults to "Do Less Studios <SMTP_USER>". Gmail only allows your own address here.
CONTACT_FROM_EMAIL=
