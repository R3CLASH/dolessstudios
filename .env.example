# Postgres connection string
# Local (docker compose up -d): postgres://doless:doless@localhost:5432/doless
DATABASE_URL=postgres://doless:doless@localhost:5432/doless

# Public site URL, used for metadata, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email (SMTP). Every brief is emailed to CONTACT_TO_EMAIL, with reply-to set to the sender.
# Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords), and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=thavishamudunkotuwa1998@gmail.com
# Optional. Defaults to "Do Less Studios <SMTP_USER>". Gmail only allows your own address here.
CONTACT_FROM_EMAIL=

# Signs the /orders/<ref> links that go in order confirmation emails. An order
# reference is short enough to guess, so the page refuses to render without a
# valid signature. Unset simply means the feature is off: the email omits the
# link and the page 404s — nothing throws and nothing half-works.
# Generate one with:  openssl rand -base64 32
ORDER_LINK_SECRET=

# Dodo Payments. All three are optional: with no API key the buy buttons don't render
# and every CTA routes to the quote form, and the webhook answers 503 without a webhook key.
# NEVER leave DODO_PAYMENTS_ENVIRONMENT blank — the SDK falls back to live_mode when it's
# unset, so an empty value here means real cards. Our own code defaults to test_mode, but
# don't rely on that; set it explicitly.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Optional local override for where Dodo sends the buyer after paying. Derived from
# NEXT_PUBLIC_SITE_URL when empty; set it when testing through a tunnel.
DODO_PAYMENTS_RETURN_URL=
# TEMPORARY, for the Sri Lanka payout test only. One product id outside the four
# solutions that /checkout will accept, so a $60 sale can be put through live mode
# (Dodo's minimum payout is $50 after fees). Remove it once the payout has landed —
# unsetting it closes the route again with no code change. See HANDOFF §3.1.
DODO_TEST_PRODUCT_ID=
